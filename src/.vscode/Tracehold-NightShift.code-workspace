{
  "folders": [
    {
      "name": "Tracehold",
      "path": "."
    }
  ],
  "settings": {
    "editor.fontFamily": "'JetBrains Mono ExtraThin', 'JetBrains Mono', monospace",
    "editor.fontSize": 11,
    "editor.fontLigatures": true,
    "editor.rulers": [
      88,
      100
    ],
    "editor.minimap.enabled": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,
    "editor.renderWhitespace": "selection",
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.minimumContrastRatio": 4.5,
    "workbench.tree.indent": 16,
    "workbench.startupEditor": "none",
    "window.autoDetectColorScheme": false,
    "workbench.colorTheme": "Default Dark Modern",
    "workbench.preferredLightColorTheme": "Default Light Modern",
    "workbench.preferredDarkColorTheme": "Default Dark Modern",
    "workbench.colorCustomizations": {
      "editor.background": "#050607",
      "editor.foreground": "#F2E8D5",
      "editorCursor.foreground": "#F2C14E",
      "editorLineNumber.foreground": "#6B5A3A",
      "editorLineNumber.activeForeground": "#F0A83A",
      "editor.selectionBackground": "#A6671E55",
      "editor.lineHighlightBackground": "#11100C",
      "activityBar.background": "#090A0C",
      "activityBar.foreground": "#F2E8D5",
      "activityBar.activeBorder": "#F0A83A",
      "activityBarBadge.background": "#B7410E",
      "activityBarBadge.foreground": "#FFF8EA",
      "sideBar.background": "#11100C",
      "sideBar.foreground": "#F2E8D5",
      "sideBarTitle.foreground": "#F0A83A",
      "sideBarSectionHeader.background": "#181711",
      "panel.background": "#11151C",
      "panel.border": "#A6671E",
      "panelTitle.activeForeground": "#F0A83A",
      "panelTitle.activeBorder": "#A6671E",
      "statusBar.background": "#3A240F",
      "statusBar.foreground": "#FFF4DF",
      "statusBar.debuggingBackground": "#B7410E",
      "terminal.background": "#050607",
      "terminal.foreground": "#F2E8D5",
      "terminalCursor.foreground": "#F2C14E",
      "tab.activeBackground": "#11151C",
      "tab.activeForeground": "#F2E8D5",
      "tab.activeBorderTop": "#F0A83A",
      "tab.inactiveBackground": "#11100C",
      "tab.inactiveForeground": "#9B8C7D",
      "list.activeSelectionBackground": "#2A2115",
      "list.activeSelectionForeground": "#F2E8D5",
      "focusBorder": "#4DB2FF"
    },
    "window.title": "TRACEHOLD // NIGHTSHIFT — ${dirty}${activeEditorShort}${separator}${rootName}",
    "terminal.integrated.env.linux": {
      "HH_PROJECT": "TRACEHOLD",
      "NO_COLOR": "",
      "HH_SHIFT": "nightshift",
      "HH_THEME": "HH Nightshift",
      "HH_BACKGROUND": "#050607",
      "HH_SURFACE": "#11100C",
      "HH_PANEL": "#11151C",
      "HH_FOREGROUND": "#F2E8D5",
      "HH_MUTED": "#9B8C7D",
      "HH_BORDER": "#A6671E",
      "HH_SELECTION": "#2A2115",
      "HH_AMBER": "#F0A83A",
      "HH_GOLD": "#F2C14E",
      "HH_BRASS": "#A6671E",
      "HH_EMBER": "#B7410E",
      "HH_COPPER": "#C97C5D",
      "HH_SIGNAL_BLUE": "#4DB2FF",
      "HH_SIGNAL_TEAL": "#76B7B2",
      "HH_MOSS": "#8FA37A",
      "HH_ROSE": "#E475B7",
      "HH_VIOLET": "#A77BD4",
      "HH_SUCCESS": "#80D878",
      "HH_WARNING": "#F0A83A",
      "HH_ERROR": "#FF6878",
      "HH_INFO": "#4DB2FF",
      "HH_DIM": "#6B5A3A",
      "HH_PROJECT_ACCENT": "#F0A83A",
      "HH_PROJECT_SECONDARY": "#4DB2FF"
    }
  },
  "extensions": {
    "recommendations": [
      "foxundermoon.shell-format",
      "ms-python.debugpy",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "rogalmic.bash-debug",
      "timonwong.shellcheck"
    ]
  }
}

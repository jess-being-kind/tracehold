{
  "folders": [
    {
      "name": "Tracehold",
      "path": "."
    }
  ],
  "settings": {
    "editor.fontFamily": "'JetBrains Mono ExtraThin', 'JetBrains Mono', monospace",
    "editor.fontSize": 11,
    "editor.fontLigatures": true,
    "editor.rulers": [
      88,
      100
    ],
    "editor.minimap.enabled": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,
    "editor.renderWhitespace": "selection",
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.minimumContrastRatio": 4.5,
    "workbench.tree.indent": 16,
    "workbench.startupEditor": "none",
    "window.autoDetectColorScheme": false,
    "workbench.colorTheme": "Light Modern",
    "workbench.preferredLightColorTheme": "Light Modern",
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "workbench.colorCustomizations": {
      "editor.background": "#FFF9ED",
      "editor.foreground": "#241D18",
      "editorCursor.foreground": "#8D2438",
      "editorLineNumber.foreground": "#A08B75",
      "editorLineNumber.activeForeground": "#7B2638",
      "editor.selectionBackground": "#D6A73E55",
      "editor.lineHighlightBackground": "#F5E8CF",
      "activityBar.background": "#3A2A23",
      "activityBar.foreground": "#FFF4D7",
      "activityBar.activeBorder": "#D3A13B",
      "activityBarBadge.background": "#8D2438",
      "activityBarBadge.foreground": "#FFF9EF",
      "sideBar.background": "#F3E8D6",
      "sideBar.foreground": "#2B211C",
      "sideBarTitle.foreground": "#6F1F31",
      "sideBarSectionHeader.background": "#E8D7BD",
      "panel.background": "#F7EDDC",
      "panel.border": "#C9B38D",
      "panelTitle.activeForeground": "#6F1F31",
      "panelTitle.activeBorder": "#B57A1E",
      "statusBar.background": "#6F1F31",
      "statusBar.foreground": "#FFF8EA",
      "statusBar.debuggingBackground": "#9A5B13",
      "terminal.background": "#FFF9ED",
      "terminal.foreground": "#241D18",
      "terminalCursor.foreground": "#8D2438",
      "tab.activeBackground": "#FFF9EC",
      "tab.activeForeground": "#241B17",
      "tab.activeBorderTop": "#B57A1E",
      "tab.inactiveBackground": "#EADCC8",
      "tab.inactiveForeground": "#705E4F",
      "list.activeSelectionBackground": "#D5B56F",
      "list.activeSelectionForeground": "#241A14",
      "focusBorder": "#1667A8"
    },
    "window.title": "TRACEHOLD // DAYSHIFT — ${dirty}${activeEditorShort}${separator}${rootName}",
    "terminal.integrated.env.linux": {
      "HH_PROJECT": "TRACEHOLD",
      "NO_COLOR": "",
      "HH_SHIFT": "dayshift",
      "HH_THEME": "HH Dayshift",
      "HH_BACKGROUND": "#FFF9ED",
      "HH_SURFACE": "#F8EFDF",
      "HH_PANEL": "#E7D6BD",
      "HH_FOREGROUND": "#241D18",
      "HH_MUTED": "#786858",
      "HH_BORDER": "#BDA47E",
      "HH_SELECTION": "#E2CC9E",
      "HH_AMBER": "#A86800",
      "HH_GOLD": "#B57A1E",
      "HH_BRASS": "#83520D",
      "HH_EMBER": "#A61B2B",
      "HH_COPPER": "#9A5B13",
      "HH_SIGNAL_BLUE": "#155F98",
      "HH_SIGNAL_TEAL": "#276E73",
      "HH_MOSS": "#4C6B37",
      "HH_ROSE": "#8D365C",
      "HH_VIOLET": "#754A8A",
      "HH_SUCCESS": "#4C6B37",
      "HH_WARNING": "#A86800",
      "HH_ERROR": "#A61B2B",
      "HH_INFO": "#155F98",
      "HH_DIM": "#9B8C7D",
      "HH_PROJECT_ACCENT": "#A86800",
      "HH_PROJECT_SECONDARY": "#155F98"
    }
  },
  "extensions": {
    "recommendations": [
      "foxundermoon.shell-format",
      "ms-python.debugpy",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "rogalmic.bash-debug",
      "timonwong.shellcheck"
    ]
  }
}

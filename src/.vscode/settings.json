{
    "files.associations": {
        "tracehold": "shellscript",
        "tracehold.sh": "shellscript",
        "*.bash": "shellscript",
        "*.sh": "shellscript"
    },
    "shellcheck.enable": true,
    "shellcheck.customArgs": [
        "--external-sources"
    ],
    "shellformat.flag": "-i 4 -ci -sr",
    "shellformat.useEditorConfig": true,
    "[shellscript]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.formatOnSave": false,
        "editor.rulers": [
            88,
            100
        ]
    },
    "files.exclude": {
        "**/.debug/evidence": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/*.pyc": true
    },
    "search.exclude": {
        "**/.debug": true,
        "**/cases": true,
        "**/.venv": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python-envs.workspaceSearchPaths": [
        "./.venv"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ]
}
